        "jsCode": "const cfg = $json;\nconst events = (cfg.body && cfg.body.events) ? cfg.body.events : [];\nconst keep = ['approvalStageFieldGid', 'boxApprovedRootFolderId', 'airtableBaseId', 'airtableTableId'];\nconst cfgOut = {};\nfor (const k of keep) cfgOut[k] = cfg[k];\nconst seen = new Set();\nconst out = [];\nfor (const e of events) {\n  if (e.resource && e.resource.resource_type === 'task' && e.action === 'changed') {\n    const gid = e.resource.gid;\n    if (!seen.has(gid)) {\n      seen.add(gid);\n      out.push({ json: { taskGid: gid, actorGid: (e.user && e.user.gid) || '', ...cfgOut } });\n    }\n  }\n}\nreturn out;"
      }
    },
