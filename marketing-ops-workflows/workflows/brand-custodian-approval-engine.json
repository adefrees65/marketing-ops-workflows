    {
      "id": "brand-custodian-ai-claude",
      "name": "Brand Custodian AI (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        304
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-5', max_tokens: 1200, system: $json.brandSystemPrompt, messages: [{ role: 'user', content: 'Asset Title: ' + $('Content Intake Form').item.json['Asset Title'] + '\\nAsset description: ' + $('Content Intake Form').item.json['Asset description'] + '\\nFile name: ' + ($json.name || 'n/a') + '\\nSubmitted by: ' + $('Content Intake Form').item.json['Name of submitter'] + ' (' + $('Content Intake Form').item.json['Email Address'] + ')' }] }) }}",
        "options": {}
      }
    },
    {
      "id": "parse-ai-verdict",
      "name": "Parse AI Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        304
      ],
      "parameters": {
        "jsCode": "const cfg  = $('Config').item.json;\nconst form = $('Content Intake Form').item.json;\n\nconst raw = (Array.isArray($json.content) && $json.content[0] && $json.content[0].text)\n  ? $json.content[0].text : '';\n\nlet v;\ntry {\n  v = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  // Fail safe: an unparseable model response escalates to full human review.\n  v = { tier: 'brand', brand_pass: true, confidence: 0, asset_type: 'unknown',\n        industry: [], vector: [], summary: '', flags: ['ai_parse_error'],\n        rationale: 'Could not parse AI output - defaulted to Brand Review. Raw: ' + String(raw).slice(0, 300) };\n}\n\nconst tierMap = { 'auto':'auto', 'auto-approve':'auto', 'design':'design', 'design review':'design',\n  'tier one':'design', 'brand':'brand', 'brand review':'brand', 'tier two':'brand' };\nlet tier = tierMap[String(v.tier || '').toLowerCase()] || 'brand';\n\nconst arr = (x) => Array.isArray(x) ? x\n  : (typeof x === 'string' && x.trim()) ? x.split(',').map(s => s.trim()) : [];\n\nconst flags = arr(v.flags);\nlet brand_pass = v.brand_pass !== false;\n\n// --- Guard 1: validate the failure against a controlled vocabulary. -------------\n// A model can report \"needs legal sign-off\" as a failed brand check, which would\n// bounce high-stakes work back to the submitter instead of routing it to a\n// reviewer. A rejection is only honoured if it cites an actual asset defect.\nconst VIOLATIONS = ['off_brand_tone','incorrect_logo_usage','incorrect_color_usage',\n  'unsubstantiated_claim','competitor_disparagement','missing_required_disclaimer',\n  'unapproved_client_footage','prohibited_content'];\n\nif (!brand_pass && !flags.some(f => VIOLATIONS.includes(f))) {\n  brand_pass = true;                 // no citable defect -> not a rejection\n  tier = 'brand';                    // but the concern is real, so escalate\n  flags.push('escalated_not_failed');\n}\n\n// --- Guard 2: co-branded work never auto-approves, regardless of model output. ---\nconst partnership = String(form['Partnership Content'] || 'No') === 'Yes';\nif (partnership && tier === 'auto') {\n  tier = 'brand';\n  flags.push('partnership_override');\n}\n\nif (flags.includes('ai_parse_error')) brand_pass = true;\n\nconst out = { ...cfg };\ndelete out.brandSystemPrompt;\n\nObject.assign(out, {\n  // --- submitter input: only what the requestor actually knows ---\n  submitterName:      form['Name of submitter'],\n  submitterEmail:     form['Email Address'],\n  assetTitle:         form['Asset Title'],\n  assetDescription:   form['Asset description'],\n  dateNeeded:         form['Date needed by'] || null,\n  region:             arr(form['Region']),\n  funnelStage:        arr(form['Funnel Stage']),\n  partnershipContent: partnership,\n\n  // --- AI inference: taxonomy the submitter no longer hand-enters ---\n  tier:       tier,\n  brand_pass: brand_pass,\n  confidence: typeof v.confidence === 'number' ? v.confidence : 0,\n  asset_type: v.asset_type || 'unknown',\n  industry:   arr(v.industry),\n  vector:     arr(v.vector),\n  summary:    v.summary || form['Asset description'],\n  flags:      flags,\n  rationale:  v.rationale || ''\n});\nreturn [{ json: out }];"
      }
    },
