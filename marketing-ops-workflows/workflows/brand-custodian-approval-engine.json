      "position": [
        1344,
        1136
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prev = $('Extract Task Events').item.json;\nconst t = $json.data || {};\n\nlet f = null;\nif (Array.isArray(t.custom_fields)) {\n  f = t.custom_fields.find(x => x.gid === prev.approvalStageFieldGid)\n   || t.custom_fields.find(x => x.name === 'Approval Stage');\n}\n\n// The reviewer of record is the task's assignee - the person who owned the\n// review - not whoever happened to trigger the webhook. No assignee means no\n// human reviewed it, which is exactly when 'AI (Auto)' is the honest answer.\nconst assigneeName = (t.assignee && t.assignee.name) ? t.assignee.name : 'AI (Auto)';\n\nreturn { json: { ...prev,\n  taskName: t.name || '',\n  taskUrl:  t.permalink_url || '',\n  stage:    (f && f.display_value) || '',\n  assigneeName } };"
      }
