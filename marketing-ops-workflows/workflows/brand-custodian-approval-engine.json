    {
      "id": "build-asana-payload",
      "name": "Build Asana Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        128
      ],
      "parameters": {
        "jsCode": "const d = $json;\nconst tierCfg = {\n  auto:   { rt: d.rtAutoApproveGid, label: 'Auto-Approve' },\n  design: { rt: d.rtTierOneGid,     label: 'Design Review' },\n  brand:  { rt: d.rtTierTwoGid,     label: 'Brand Review' },\n}[d.tier];\nconst autoResolve = d.tier === 'auto' && d.shadowMode !== true;\nconst custom_fields = {};\ncustom_fields[d.reviewTypeFieldGid] = tierCfg.rt;\ncustom_fields[d.approvalStageFieldGid] = autoResolve ? d.asApprovedGid : d.asReadyForReviewGid;\nconst notes = [\n  'Submitted by: ' + d.submitterName + ' (' + d.submitterEmail + ')',\n  'Asset description: ' + d.assetDescription,\n  'Submitted - region: ' + (d.region.join(', ') || 'n/a') + ' | funnel: ' + (d.funnelStage.join(', ') || 'n/a') + ' | partnership: ' + (d.partnershipContent ? 'Yes' : 'No'),\n  '',\n  '— Brand Custodian AI —',\n  'Tier: ' + tierCfg.label,\n  'Confidence: ' + d.confidence,\n  'Flags: ' + (d.flags.length ? d.flags.join(', ') : 'none'),\n  'Inferred - type: ' + d.asset_type + ' | vertical: ' + (d.industry.join(', ') || 'n/a') + ' | service line: ' + (d.vector.join(', ') || 'n/a'),\n  d.rationale ? 'Rationale: ' + d.rationale : '',\n  '',\n  'File: stored in Box staging (stubbed in this sandbox).',\n].filter(l => l !== null).join('\\n');\nconst payload = { data: {\n  name: d.assetTitle,\n  notes: notes,\n  projects: [d.asanaProjectGid],\n  custom_fields: custom_fields,\n} };\nif (d.dateNeeded) payload.data.due_on = String(d.dateNeeded).slice(0, 10);\nreturn [{ json: { ...d,\n  tierLabel: tierCfg.label,\n  autoResolve: autoResolve,\n  initialStatus: autoResolve ? 'Approved' : 'Pending',\n  needsShadowPing: d.tier === 'auto' && d.shadowMode === true,\n  asanaPayload: payload } }];"
      }
    },
